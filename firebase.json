{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "audit_schema": {
    "events": {
      "timestamp": "ISO-8601 string",
      "session_id": "string",
      "experiment_id": "integer",
      "prompt": "string",
      "response": "string",
      "status": "ALLOWED | BLOCKED | WARNED",
      "pii_detected": "array",
      "urgency_flag": "boolean",
      "risk_score": "float",
      "latency_ms": "float"
    }
  }
}
